before_staged_diff="$(mktemp)"
before_unstaged_diff="$(mktemp)"
after_staged_diff="$(mktemp)"
after_unstaged_diff="$(mktemp)"

cleanup() {
  rm -f "$before_staged_diff" "$before_unstaged_diff" "$after_staged_diff" "$after_unstaged_diff"
}

trap cleanup EXIT

git diff --cached --binary -- >"$before_staged_diff"
git diff --binary -- >"$before_unstaged_diff"

# Check only the packages this branch changed, plus their dependents. CI checks the full workspace.
# --affected skips the root tasks when no package changed, so they are named here.
# A local `main` is often stale, so compare against origin/main.
export TURBO_SCM_BASE="${TURBO_SCM_BASE:-origin/main}"

# Turbo fails when the base ref is missing, for example in a fork. Check the full workspace then.
affected_flag="--affected"
if ! git rev-parse --verify --quiet "${TURBO_SCM_BASE}^{commit}" >/dev/null; then
  echo "pre-commit: ${TURBO_SCM_BASE} not found, checking the full workspace."
  affected_flag=""
fi

quality_status=0
# shellcheck disable=SC2086 # affected_flag is empty or one flag
pnpm exec turbo run quality:fix lint:fix:root format:root typecheck:root check:packages check:deps:root \
  $affected_flag --concurrency=4 --output-logs=errors-only --no-update-notifier || quality_status=$?

git diff --cached --binary -- >"$after_staged_diff"
git diff --binary -- >"$after_unstaged_diff"

if ! cmp -s "$before_staged_diff" "$after_staged_diff" || ! cmp -s "$before_unstaged_diff" "$after_unstaged_diff"; then
  echo
  if [ "$quality_status" -ne 0 ]; then
    echo "quality:fix failed and made changes. Review and stage them, then commit again after fixing remaining issues."
  else
    echo "quality:fix made changes. Review and stage them, then commit again."
  fi
  exit 1
fi

exit "$quality_status"

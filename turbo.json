{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "pnpm-lock.yaml",
    "mise.toml",
    "mise.lock",
    "tsconfig.base.json",
    "tsconfig.ui.base.json",
    "tsdown.config.base.ts",
    "tsdown.config.mcp.ts",
    "vite.config.base.ts",
    "vitest.config.ts",
    "vitest.config.mcp.ts",
    "types/**",
    "assets/**",
    "oxlint.json",
    ".oxfmtrc.jsonc",
    "codegen.ts",
    "schema.graphql",
    "skills/transcend-custom-functions/**",
    "skills/transcend-policy-engine/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "//#generate:root", "generate"],
      "outputs": ["dist/**"]
    },
    "generate": {
      "dependsOn": ["^generate"],
      "outputs": ["src/**/__generated__/**"]
    },
    "test": {
      "dependsOn": ["transit", "//#generate:root", "generate"],
      "outputs": []
    },
    "test:integration": {
      "dependsOn": ["transit", "//#generate:root", "generate"],
      "cache": false,
      "outputs": []
    },
    "quality": {
      "dependsOn": [
        "lint",
        "//#lint:root",
        "format:check",
        "//#format:check:root",
        "quality:checks"
      ]
    },
    "quality:checks": {
      "dependsOn": [
        "typecheck",
        "typecheck:ui",
        "//#typecheck:root",
        "//#check:packages",
        "check:deps",
        "//#check:deps:root",
        "check:exports",
        "check:publint"
      ]
    },
    "quality:fix": {
      "dependsOn": ["lint:fix", "//#lint:fix:root", "format", "//#format:root", "quality:checks"]
    },
    "typecheck": {
      "dependsOn": ["transit", "//#generate:root", "generate"],
      "outputs": []
    },
    "typecheck:ui": {
      "dependsOn": ["transit", "generate"],
      "outputs": []
    },
    "//#generate:root": {
      "inputs": [
        "codegen.ts",
        "schema.graphql",
        "packages/mcp/mcp-server-*/src/**/*.ts",
        "!packages/mcp/mcp-server-*/src/__generated__/**"
      ],
      "outputs": ["packages/mcp/mcp-server-*/src/__generated__/**"]
    },
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "format": {
      "cache": false
    },
    "format:check": {},
    "check:exports": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:publint": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:skill-bundle": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "check:deps": {},
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "//#test:root": {
      "dependsOn": ["//#generate:root"],
      "outputs": []
    },
    "//#typecheck:root": {
      "dependsOn": ["//#generate:root"],
      "outputs": []
    },
    "//#lint:root": {},
    "//#lint:fix:root": {
      "cache": false
    },
    "//#format:root": {
      "cache": false
    },
    "//#format:check:root": {},
    "//#check:packages": {},
    "//#check:deps:root": {},
    "@transcend-io/mcp#typecheck": {
      "dependsOn": ["^build", "//#generate:root"],
      "outputs": []
    },
    "@transcend-io/mcp#test": {
      "dependsOn": ["^build", "//#generate:root"],
      "outputs": []
    },
    "@transcend-io/design-tokens#build": {
      "dependsOn": ["^build", "generate"],
      "inputs": ["src/**", "tokens/**", "package.json", "tsdown.config.ts"],
      "outputs": ["dist/**"]
    },
    "@transcend-io/design-tokens#test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "@transcend-io/design-tokens#generate": {
      "dependsOn": ["^generate"],
      "inputs": ["tokens/**", "plugins/**", "terrazzo.config.ts", "package.json"],
      "outputs": ["src/__generated__/**"]
    },
    "@transcend-io/custom-function-types#generate": {
      "dependsOn": ["^generate"],
      "inputs": ["scripts/**", "src/**", "!src/__generated__/**", "package.json", "tsconfig.json"],
      "outputs": ["src/__generated__/**"]
    },
    "@transcend-io/cli#generate": {
      "dependsOn": ["^generate"],
      "outputs": ["README.md", "schema/**"]
    },
    "@transcend-io/cli#quality:checks": {
      "dependsOn": [
        "typecheck",
        "typecheck:ui",
        "//#typecheck:root",
        "//#check:packages",
        "check:deps",
        "//#check:deps:root",
        "check:exports",
        "check:publint",
        "check:skill-bundle"
      ]
    }
  }
}
